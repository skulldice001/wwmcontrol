# ─────────────────────────────────────────────────────────────────────────────
# Docker Production Environment Template
# Copy this file to .env and fill in all required values.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="The Zoo"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.thezootopia.online

FRONTEND_URL=https://thezootopia.online
SANCTUM_STATEFUL_DOMAINS=thezootopia.online,api.thezootopia.online

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────────────────────
# Set DB_HOST=db to use the bundled PostgreSQL container.
# Set DB_HOST=<your-server-ip> to use an external PostgreSQL server.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wwm
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=null

# ── Session / Queue / Cache ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.thezootopia.online
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Laravel Reverb (WebSocket server) ────────────────────────────────────────
# Generate any random values for APP_ID / KEY / SECRET.
REVERB_APP_ID=the-zoo-app
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_SERVER_PORT=8080

# ── Vite / Client-side WebSocket ─────────────────────────────────────────────
# These are baked into the JS bundle at build time.
# VITE_REVERB_HOST = public hostname clients connect to (same as APP_URL host).
VITE_REVERB_APP_KEY=CHANGE_ME_REVERB_KEY     # must match REVERB_APP_KEY above
VITE_REVERB_HOST=api.thezootopia.online
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=https

# ── Discord Integration ───────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=${APP_URL}/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_ROLE_ID=

# ── Port mapping ─────────────────────────────────────────────────────────────
APP_PORT=80
