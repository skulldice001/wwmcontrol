{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"php artisan serve --host=127.0.0.1 --port=8000\" \"cd frontend && npm run dev\"",
